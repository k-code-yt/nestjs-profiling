{
  "title": "Bandwidth & Network Performance Dashboard",
  "timezone": "browser",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "WebSocket Bandwidth Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(websocket_bytes_sent_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "Outbound Mbps"
        },
        {
          "expr": "rate(websocket_bytes_received_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "Inbound Mbps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "displayName": "Bandwidth",
          "custom": {
            "axisLabel": "Megabits per second"
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "SSE Bandwidth Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(sse_bytes_sent_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "SSE Outbound Mbps"
        },
        {
          "expr": "rate(http_response_size_bytes_sum{handler=~\".*sse.*\"}[1m]) * 8 / 1024 / 1024",
          "legendFormat": "HTTP SSE Response Mbps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "displayName": "SSE Bandwidth"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Message Size Distribution (WebSocket)",
      "type": "heatmap",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(websocket_message_size_bytes_bucket[5m])",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "vis": false
            }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Message Size Distribution (SSE)",
      "type": "heatmap",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(sse_message_size_bytes_bucket[5m])",
          "legendFormat": "{{le}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Total Data Transfer Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(rate(websocket_bytes_sent_total[1m]) + rate(sse_bytes_sent_total[1m])) / 1024 / 1024",
          "legendFormat": "Total MB/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBs",
          "displayName": "Combined Transfer Rate",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "Compression Efficiency",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(1 - (websocket_compressed_bytes_total / websocket_uncompressed_bytes_total)) * 100",
          "legendFormat": "WS Compression %"
        },
        {
          "expr": "(1 - (sse_compressed_bytes_total / sse_uncompressed_bytes_total)) * 100",
          "legendFormat": "SSE Compression %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "Compression Ratio",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 }
    },
    {
      "id": 7,
      "title": "Network Latency Distribution",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(websocket_message_latency_seconds_bucket[5m]))",
          "legendFormat": "WS 95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, rate(websocket_message_latency_seconds_bucket[5m]))",
          "legendFormat": "WS 50th percentile"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sse_message_latency_seconds_bucket[5m]))",
          "legendFormat": "SSE 95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, rate(sse_message_latency_seconds_bucket[5m]))",
          "legendFormat": "SSE 50th percentile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "displayName": "Latency"
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 8,
      "title": "Message Frequency by Size Range",
      "type": "table",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (size_range) (rate(websocket_messages_by_size_total[5m]))",
          "legendFormat": "WebSocket {{size_range}}",
          "format": "table"
        },
        {
          "expr": "sum by (size_range) (rate(sse_messages_by_size_total[5m]))",
          "legendFormat": "SSE {{size_range}}",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "Value": "Messages/sec"
            }
          }
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 }
    },
    {
      "id": 9,
      "title": "Connection Bandwidth per Client",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(websocket_bytes_sent_total[1m]) / (sum(websocket_connections_total{event=\"connect\"}) - sum(websocket_connections_total{event=\"disconnect\"}))",
          "legendFormat": "WS Bytes/sec per connection"
        },
        {
          "expr": "rate(sse_bytes_sent_total[1m]) / (sum(sse_connections_total{event=\"connect\"}) - sum(sse_connections_total{event=\"disconnect\"}))",
          "legendFormat": "SSE Bytes/sec per connection"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "displayName": "Per-Connection Bandwidth"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 }
    },
    {
      "id": 10,
      "title": "Network Interface Statistics",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[1m]) * 8 / 1024 / 1024",
          "legendFormat": "TX {{device}} Mbps"
        },
        {
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[1m]) * 8 / 1024 / 1024",
          "legendFormat": "RX {{device}} Mbps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "displayName": "Network Interface"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 }
    },
    {
      "id": 11,
      "title": "Payload Type Distribution",
      "type": "piechart",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (payload_type) (rate(websocket_messages_by_type_total[5m]))",
          "legendFormat": "{{payload_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "vis": false
            }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 }
    },
    {
      "id": 12,
      "title": "Bandwidth vs Load Test Scenario",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(websocket_bytes_sent_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "WebSocket Bandwidth"
        },
        {
          "expr": "rate(sse_bytes_sent_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "SSE Bandwidth"
        },
        {
          "expr": "sum(websocket_connections_total{event=\"connect\"}) - sum(websocket_connections_total{event=\"disconnect\"})",
          "legendFormat": "Active WS Connections"
        },
        {
          "expr": "sum(sse_connections_total{event=\"connect\"}) - sum(sse_connections_total{event=\"disconnect\"})",
          "legendFormat": "Active SSE Connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Connections"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Bandwidth"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Mbits"
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 }
    },
    {
      "id": 13,
      "title": "HAProxy Total Bandwidth",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(haproxy_frontend_bytes_out_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "Frontend Out (Mbps)"
        },
        {
          "expr": "rate(haproxy_backend_bytes_in_total[1m]) * 8 / 1024 / 1024",
          "legendFormat": "Backend In (Mbps)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 }
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s"
}
