{
  "title": "NestJS Memory Usage",
  "timezone": "browser",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Node.js Memory Usage(MB)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "nodejs_memory_usage_bytes{type=\"heap_used\"} / 1024 / 1024",
          "legendFormat": "Heap Used (MB)"
        },
        {
          "expr": "nodejs_memory_usage_bytes{type=\"heap_total\"} / 1024 / 1024",
          "legendFormat": "Heap Total (MB)"
        },
        {
          "expr": "nodejs_memory_usage_bytes{type=\"rss\"} / 1024 / 1024",
          "legendFormat": "RSS (MB)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Container Memory (256MB Limit)",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "nodejs_memory_usage_bytes{type=\"rss\"}",
          "legendFormat": "Memory Usage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "max": 268435456,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 157286400 },
              { "color": "red", "value": 209715200 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "Requests/sec"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 4,
      "title": "Request Count by Endpoint",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(http_requests_total[5m])",
          "legendFormat": "{{method}} {{route}} ({{status_code}})"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "title": "Memory Usage by Endpoint",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "http_endpoint_memory_usage_mb",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 6,
      "title": "HTTP Request Duration",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "50th percentile"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 7,
      "title": "Memory Usage (w/o cache)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "nodejs_heap_space_size_used_bytes{space=\"old\"}",
          "legendFormat": "old-space-used"
        },
        {
          "expr": "nodejs_heap_space_size_used_bytes{space=\"new\"}",
          "legendFormat": "new-space-used"
        },
        {
          "expr": "nodejs_heap_space_size_used_bytes{space=\"code\"}",
          "legendFormat": "code-space-used"
        },
        {
          "expr": "nodejs_memory_usage_bytes{type=\"external\"}",
          "legendFormat": "external-memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 50,
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "vis": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 268435456
              }
            ]
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "old-space-used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1f77b4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "new-space-used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff7f0e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "code-space-used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2ca02c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "external-memory"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d62728"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 200
        }
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s"
}
